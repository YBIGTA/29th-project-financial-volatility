__pycache__/
*.pyc
.venv/
.env

# 데이터는 Google Drive로 관리 — 원본 raw/processed csv는 git에 올리지 않음
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local datasets and generated artifacts
data/
artifacts/

# Ignore Markdown documentation except the root README
*.md
!/README.md

# 종목별 정리(merged csv + 차트)도 Drive로 관리
data/정리/
